build/
install/
log/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.vscode/
.idea/
*.swp
# Recorded bags are local evidence artifacts, not source. The patterns are
# recursive because ros2 bag writes into a per-run subdirectory, so a top-level
# glob silently fails to match and a 46 MB mcap lands in a commit.
rosbags/**/*.db3
rosbags/**/*.mcap
rosbags/**/metadata.yaml
results/*.png
# ...except the Phase 1 evidence figures. They are small, they are the artifact an
# evaluator looks at first, and a .pgm does not render in a browser.
!results/phase1_*.png
!results/phase2_*.png

# Worlds rendered from xacro at launch time.
generated/
