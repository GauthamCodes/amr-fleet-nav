build/
install/
log/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.vscode/
.idea/
*.swp
# Recorded bags are local evidence artifacts, not source. The patterns are
# recursive because ros2 bag writes into a per-run subdirectory, so a top-level
# glob silently fails to match and a 46 MB mcap lands in a commit.
rosbags/**/*.db3
rosbags/**/*.mcap
rosbags/**/metadata.yaml
results/*.png
# ...except the evidence figures. They are small, they are the artifact an
# evaluator looks at first, and a .pgm does not render in a browser.
!results/phase1_*.png
!results/phase2_*.png
# phase5_payload_trace.png is the payload-adaptive deliverable itself - the
# velocity/jerk plot, loaded against unloaded. It was excluded by the glob above
# and therefore silently absent from the repository while being cited as the
# headline artifact of that requirement.
!results/phase5_*.png

# Worlds rendered from xacro at launch time.
generated/

# Screen recordings. The submission screenshare is delivered separately and is
# deliberately NOT in the repository - it is far larger than anything else here
# and it is not something an evaluator needs to clone. videos/ is kept (via
# .gitkeep) as the place to put it locally while recording.
*.mp4
*.mkv
*.webm
# No exception any more. media/ used to carry four short .mp4 clips; they were
# replaced by the GIF previews in media/previews/, which GitHub plays inline in the
# README and in HOW_TO_RUN next to the command that produces them. A clip an
# evaluator has to download and open in a player is a clip they will not watch.

# Demo runs write their own artifacts into results/. These are per-run outputs of
# a demonstration, not the committed evidence they sit beside - the canonical
# selective-update artifact is results/phase3_selective_updates.md.
results/fleet_survey_updates.md
results/fleet_survey_updates.csv
