<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_motion</name>
  <version>0.1.0</version>
  <description>
    Payload-adaptive motion smoothing. PayloadJerkAdapter chains AFTER the stock
    nav2_velocity_smoother and adds only what the stock node lacks: jerk limiting and
    payload-scaled acceleration limits. Nav2 is extended here, not duplicated.
  </description>
  <maintainer email="gauthamanil888@gmail.com">Gautham</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>amr_description</exec_depend>
  <!-- topics.py, the one topic contract. -->
  <exec_depend>amr_bsp</exec_depend>
  <!-- The twist_mux priority table is a safety-policy decision and lives in
       amr_safety/config, next to the gate it feeds. This package launches the
       node; that package owns what the priorities mean. -->
  <exec_depend>amr_safety</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
