<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_description</name>
  <version>0.1.0</version>
  <description>
    Single parameterized diff-drive AMR description. One xacro serves every robot in the
    fleet; per-robot differences (mass, wheelbase, sensor height, acceleration limits)
    arrive as xacro arguments sourced from the typed robot list in config/fleet.yaml.
    There are deliberately no per-robot xacro files.
  </description>
  <maintainer email="gauthamanil888@gmail.com">Gautham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
