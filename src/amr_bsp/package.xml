<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bsp</name>
  <version>0.1.0</version>
  <description>
    SensorBSP: a reusable validating relay plus IMU, LiDAR and camera validators, and the
    PitchGate that truncates the ramp's phantom ground return using measured IMU pitch.
    Nothing in the navigation stack subscribes to a raw sensor topic; everything reads this
    package's validated output. Republished messages preserve their ORIGINAL header
    timestamps, because rewriting them breaks TF and SLAM silently.
  </description>
  <maintainer email="gauthamanil888@gmail.com">Gautham</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- nav2_readiness asks each managed Nav2 node for its lifecycle state. -->
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>amr_description</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
